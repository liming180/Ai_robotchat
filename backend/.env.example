# 智谱 AI API 配置示例
# 复制此文件为 .env 并填入你的真实配置

# 智谱 API Key (从 https://open.bigmodel.cn 获取)
ZHIPU_API_KEY=4545b9e1adec45c08b53481a5a89759f.gXcXow7j1SmbmbcZ

# 模型配置
ZHIPU_MODEL=glm-4.5-air
ZHIPU_VISION_MODEL=glm-4v-flash
ZHIPU_IMAGE_MODEL=cogview-3

# API 基础地址 (通常不需要修改)
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型参数
ZHIPU_TEMPERATURE=0.7
ZHIPU_MAX_TOKENS=1024
ZHIPU_TOP_P=0.9

# 数据库配置 (开发环境默认 SQLite，生产环境请使用 PostgreSQL/MySQL)
# PostgreSQL 示例: postgresql://user:password@localhost:5432/ai_companion
# MySQL 示例: mysql+pymysql://user:password@localhost:3306/ai_companion
DATABASE_URL=sqlite:///./ai_companion.db

# Redis 配置
REDIS_URL=redis://localhost:6379/1

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=true
