# ─────────────────────────────────────────────
# AI 服务配置模板 —— 双模型架构
# 复制此文件为 .env 并填入你的真实配置（.env 已被 gitignore）
# 文本链路：小米 MiMo（对话 / suggestions / RAG / tool calling）
# 视觉链路：GPTCODEX 中转站（图片理解）
# 图像生成：无远程模型，置空走本地 SVG 降级
# ─────────────────────────────────────────────

# ── 文本链路（小米 MiMo，https://platform.xiaomimimo.com/） ──
LLM_MODEL_API_KEY=sk-***
LLM_MODEL_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL_MODEL=mimo-v2.6-flash

# ── 视觉链路（GPTCODEX 中转站，图片理解） ──
LLM_VISION_API_KEY=sk-***
LLM_VISION_BASE_URL=https://gptcodex.top/v1
LLM_VISION_MODEL=gpt-6-luna

# ── 图像生成（置空 → 本地 SVG 头像降级） ──
LLM_IMAGE_MODEL=

# ── 采样参数（两条链路共用） ──
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.9

# ── 数据库（开发环境默认 SQLite，生产环境请使用 PostgreSQL/MySQL） ──
# PostgreSQL 示例: postgresql://user:password@localhost:5432/ai_companion
# MySQL 示例: mysql+pymysql://user:password@localhost:3306/ai_companion
DATABASE_URL=sqlite:///./ai_companion.db

# ── Redis（可选，不可用时自动降级内存缓存） ──
REDIS_URL=redis://localhost:6379/1

# ── 应用配置 ──
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=true
