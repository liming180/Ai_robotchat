# ─────────────────────────────────────────────
# AI 服务配置模板 —— 智谱 GLM（单平台）
# 复制此文件为 .env 并填入你的真实配置（.env 已被 gitignore）
# 文本链路：智谱 GLM glm-4.5-air（对话 / suggestions / RAG / tool calling）
# 视觉链路：智谱 GLM glm-4v-flash（图片理解），与文本共用同一个 key
# 图像生成：智谱 CogView cogview-4（AI 头像）；置空则走本地 SVG 降级
# ─────────────────────────────────────────────

# ── 智谱 GLM（从 https://open.bigmodel.cn 获取 key） ──
ZHIPU_API_KEY=sk-***
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.5-air
ZHIPU_VISION_MODEL=glm-4v-flash
# 视觉/图像 key 默认复用 ZHIPU_API_KEY；仅当走别的账号时才取消下面这行
# ZHIPU_VISION_API_KEY=sk-***

# ── 图像生成（置空 → 本地 SVG 头像降级） ──
ZHIPU_IMAGE_MODEL=cogview-4

# ── 采样参数（两条链路共用） ──
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.9

# ── 数据库（开发环境默认 SQLite，生产环境请使用 PostgreSQL/MySQL） ──
# PostgreSQL 示例: postgresql://user:password@localhost:5432/ai_companion
# MySQL 示例: mysql+pymysql://user:password@localhost:3306/ai_companion
DATABASE_URL=sqlite:///./ai_companion.db

# ── Redis（可选，不可用时自动降级内存缓存） ──
REDIS_URL=redis://localhost:6379/1

# ── 应用配置 ──
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=true

# ── 流式端点共享密钥（仅防误调，不是安全加固：前端 token 会进浏览器产物）──
# 本地开发可设任意字符串，如 dev-token-2026；不配置则跳过校验
SERVICE_TOKEN=<随机生成的共享密钥，与 RAG 8002 同值>
