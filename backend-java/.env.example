# AI Companion — Java 业务后端环境变量模板
#
# 本文件不含真实密钥，可入库。复制为 .env 或直接设为系统环境变量后使用：
#   PowerShell（用户级，需新开终端生效）：
#     setx MYSQL_PASSWORD "你的密码"
#     setx REDIS_PASSWORD "你的密码"
#     setx JWT_SECRET "至少32字节的随机串"
#
# 注意：application.yml 用 ${VAR:默认值} 引用这些变量；未设置时会走默认值，
#      JWT_SECRET 未设置时启动日志会打印告警。

# MySQL 密码（application.yml 的 spring.datasource.password 使用）
MYSQL_PASSWORD=

# Redis 密码（application.yml 的 spring.data.redis.password 使用）
REDIS_PASSWORD=

# JWT 签名密钥。HS256 要求至少 32 字节（256 位）。
# 生产环境必须设置；未设置时使用 application.yml 的开发默认值并打印告警。
JWT_SECRET=

# 验证码 mock 开关。【仅本地测试用，默认关闭】
# 留空或 false：走真实验证码（存 Redis，需 Redis 可用，邮箱验证码打印到 Java 控制台）。
# 设为 true：验证码固定为 123456，且 /api/v1/auth/send-email-code 响应里回填 code，
#           方便本地不做邮箱接入就能注册。生产环境严禁设为 true。
# 注意：这是环境变量，不是 .env 文件——Spring 不自动读取 .env，需用 setx 设为用户级
#      变量或启动前 export，且新开终端才生效。
APP_EMAIL_MOCK=
