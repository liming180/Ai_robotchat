# ===== RAG 知识库系统配置示例 =====
# 复制为 .env 后按实际环境填写

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8002
APP_DEBUG=true
APP_ENV=development

# ---- 元数据库 ----
# 共用主项目 MySQL 实例，独立 database（不共库）
DATABASE_URL=mysql+pymysql://root:<你的MySQL密码>@localhost:3306/rag_knowledge?charset=utf8mb4

# ---- 向量库 ----
# 存储后端选择：milvus（新，2026-11-19）/ chroma（旧，保留回退）
VECTOR_STORE_BACKEND=milvus

# Chroma 配置（旧后端，保留回退）
CHROMA_PERSIST_DIR=./storage/chroma_db

# Milvus 配置（新后端，2026-11-19）
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 认证信息（可选，留空表示无认证；生产环境建议启用 RBAC）
MILVUS_USER=
MILVUS_PASSWORD=

# ---- Embedding ----
# Chroma 旧后端：本地哈希向量（256 维，无外部依赖）
# Milvus 新后端：由 Milvus Function 服务端调用智谱 Embedding-3（2048 维），
#   凭证配置在 deploy/milvus/milvus.yaml，此处无需配置

# ---- 上传限制 ----
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=json,md,txt

# ---- 切片默认值 ----
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# ---- 检索 ----
RETRIEVE_TOP_K=4
RETRIEVE_SCORE_THRESHOLD=0.0

# ---- 主服务 JWT（二期启用鉴权时填写，需与 Java 端一致）----
JWT_SECRET_KEY=your-super-secret-key-at-least-256-bits-long-for-hs256-algorithm
JWT_ALGORITHM=HS256

# ---- 登录转发（RAG 管理前端登录 → Java 8081，2026-11-17）----
JAVA_AUTH_URL=http://localhost:8081

# ---- Redis（二期异步队列，db 2）----
# REDIS_URL=redis://:<你的Redis密码>@localhost:6379/2
