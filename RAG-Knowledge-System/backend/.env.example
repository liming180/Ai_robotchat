# ===== RAG 知识库系统配置示例 =====
# 复制为 .env 后按实际环境填写

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8002
APP_DEBUG=true
APP_ENV=development

# ---- 元数据库 ----
# 共用主项目 MySQL 实例，独立 database（不共库）
DATABASE_URL=mysql+pymysql://root:<你的MySQL密码>@localhost:3306/rag_knowledge?charset=utf8mb4

# ---- 向量库 ----
CHROMA_PERSIST_DIR=./storage/chroma_db

# ---- Embedding（本地哈希向量，无外部依赖、无需配置）----
# 原智谱 embedding-3 已移除（key 已作废），现用本地哈希向量 simple-hash / 256 维

# ---- 上传限制 ----
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=json,md,txt

# ---- 切片默认值 ----
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# ---- 检索 ----
RETRIEVE_TOP_K=4
RETRIEVE_SCORE_THRESHOLD=0.0

# ---- 主服务 JWT（二期启用鉴权时填写，需与 Java 端一致）----
JWT_SECRET_KEY=your-super-secret-key-at-least-256-bits-long-for-hs256-algorithm
JWT_ALGORITHM=HS256

# ---- Redis（二期异步队列，db 2）----
# REDIS_URL=redis://:<你的Redis密码>@localhost:6379/2
